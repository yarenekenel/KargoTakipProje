@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="hero-section text-center py-5 mb-5">
    <div class="mb-4">
        <span style="font-size: 64px;">📦</span>
    </div>
    <h1 class="fw-bold mb-3">KargoTakip</h1>
    <p class="text-muted fs-5 mb-4">Kargonuzu kolayca takip edin, süreci baştan sona yönetin.</p>
</div>

<div class="row g-4 justify-content-center mb-5">
    <div class="col-md-5">
        <div class="card h-100 text-center p-4 landing-card">
            <div class="mb-3" style="font-size: 40px;">🔍</div>
            <h4 class="fw-semibold">Kargonuzu Takip Edin</h4>
            <p class="text-muted">Takip numaranızla kargonuzun güncel durumunu anında öğrenin.</p>
            <a asp-controller="Kargo" asp-action="MusteriTakip" class="btn btn-primary mt-auto">Kargo Takip Et</a>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card h-100 text-center p-4 landing-card">
            <div class="mb-3" style="font-size: 40px;">🗂️</div>
            <h4 class="fw-semibold">Admin Paneli</h4>
            <p class="text-muted">Kargo kayıtlarını yönetin, durum güncelleyin ve raporları görüntüleyin.</p>
            <a asp-controller="Kargo" asp-action="Index" class="btn btn-outline-primary mt-auto">Panele Git</a>
        </div>
    </div>
</div>

<div class="row g-4 text-center">
    <div class="col-md-4">
        <div class="stat-box">
            <div class="stat-number">@ViewBag.ToplamKargo</div>
            <p class="text-muted small mb-0">Toplam Takip Edilen Kargo</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-box">
            <div class="stat-number">@ViewBag.BugunOlusturulan</div>
            <p class="text-muted small mb-0">Bugün Oluşturulan Kargo</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-box">
            <div class="stat-number">%@ViewBag.TeslimatOrani</div>
            <p class="text-muted small mb-0">Teslimat Oranı</p>
        </div>
    </div>
</div>