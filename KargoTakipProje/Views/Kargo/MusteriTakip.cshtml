@{
    ViewData["Title"] = "Kargo Takip";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header text-center">
                📦 Kargonuzu Takip Edin
            </div>
            <div class="card-body p-4">
                <form asp-action="MusteriTakipSonuc" method="get">
                    <div class="mb-3">
                        <label class="form-label">Takip Numaranız</label>
                        <input type="text" name="takipNo" class="form-control" placeholder="Örn: TR123456789" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Kargoyu Sorgula</button>
                </form>
            </div>
        </div>
    </div>
</div>